# Local PostgreSQL connection. Replace YOUR_PASSWORD with your local database password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/visionary_paper_db
# Generate a unique secret (at least 32 random bytes) for this environment.
SECRET_KEY=replace-with-a-unique-random-secret-before-running
# Local uploads; on Azure set UPLOAD_DIR=/home/data/uploads for persistent storage.
UPLOAD_DIR=./uploads
